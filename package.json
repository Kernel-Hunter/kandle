{
  "name": "kandle",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source charting app for crypto markets that you can run in the browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm --filter kandle-mcp build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "pnpm --filter kandle-mcp build && node packages/mcp/bin/kandle-mcp.js"
  },
  "dependencies": {
    "klinecharts": "10.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "kandle-mcp": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  }
}
