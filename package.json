{
  "name": "kandle",
  "version": "0.10.1",
  "private": true,
  "description": "Free, open-source charting app for crypto, stocks and forex that your AI agent can drive.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && pnpm --filter kandle-mcp build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "mcp": "pnpm --filter kandle-mcp build && node packages/mcp/bin/kandle-mcp.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "klinecharts": "10.0.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "kandle-mcp": "workspace:*",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  }
}
